                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Project page', '项目主页'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{Binding RepoText}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource LinkButton}" Tag="github" VerticalAlignment="Center"
                                        Content="{local:Tr 'Open', '打开'}"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Reset settings', '恢复默认设置'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{Binding ResetHint}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Tag="reset" MinWidth="0" VerticalAlignment="Center"
                                        Content="{local:Tr 'Reset', '恢复'}" IsEnabled="{Binding CanReset}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Margin="0,12,0,0" Background="{DynamicResource Footer}" Height="56">
                <Grid Margin="20,0,12,0">
                    <TextBlock Text="{Binding FooterText}" Foreground="{DynamicResource SubText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,100,0"/>
                    <Button Style="{StaticResource ActionButton}" Tag="exit" Content="{local:Tr 'Exit', '退出'}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" ToolTip="{local:Tr 'Close the tray panel; the watchdog keeps running', '关闭托盘面板，后台看门狗继续运行'}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
