<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:NetWatchdogUI"
        Title="{local:Tr 'NetWatchdog', '网络看门狗'}" Width="360" Height="480" SizeToContent="Manual"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A settings row: title and description on the left, a control on the right -->
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="RowDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubText}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{DynamicResource Bg}">
        <Grid x:Name="Body">
            <Grid.RenderTransform>
                <TranslateTransform/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header of the main page: title and buttons (language, theme, refresh, settings), status line below -->
            <Grid Grid.Row="0" Margin="20,10,12,12" Visibility="{Binding MainVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{local:Tr 'NetWatchdog', '网络看门狗'}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Tag="menu:lang" Content="&#xE774;"
                            ToolTip="{local:Tr 'Language', '语言'}"/>
                    <Button Style="{StaticResource IconButton}" Tag="menu:theme" Content="&#xE793;"
                            ToolTip="{local:Tr 'Theme', '主题'}"/>
                    <Button Style="{StaticResource IconButton}" Tag="probe" Content="&#xE72C;"
                            ToolTip="{local:Tr 'Check again now', '立即重新检测'}"/>
                    <Button Style="{StaticResource IconButton}" Tag="settings" Content="&#xE713;"
                            ToolTip="{local:Tr 'Settings', '设置'}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,8,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding HeroBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusLine}" Foreground="{DynamicResource SubText}" Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="296" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Menus of the language and theme buttons; the panel opens them next to the clicked button -->
                <Popup x:Name="LangPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Margin="12" Width="190" Padding="4" CornerRadius="8" BorderThickness="1" TextElement.FontSize="12"
                            BorderBrush="{DynamicResource Stroke}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menulang" Tag="lang:auto"
                                         IsChecked="{Binding LangAuto, Mode=OneWay}" Content="{local:Tr 'Follow system', '跟随系统'}"/>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menulang" Tag="lang:zh"
                                         IsChecked="{Binding LangZh, Mode=OneWay}" Content="简体中文"/>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menulang" Tag="lang:zh-TW"
                                         IsChecked="{Binding LangZhTw, Mode=OneWay}" Content="繁體中文"/>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menulang" Tag="lang:en"
                                         IsChecked="{Binding LangEn, Mode=OneWay}" Content="English"/>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menulang" Tag="lang:ja"
                                         IsChecked="{Binding LangJa, Mode=OneWay}" Content="日本語"/>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menulang" Tag="lang:ko"
                                         IsChecked="{Binding LangKo, Mode=OneWay}" Content="한국어"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Popup x:Name="ThemePopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Margin="12" Width="190" Padding="4" CornerRadius="8" BorderThickness="1" TextElement.FontSize="12"
                            BorderBrush="{DynamicResource Stroke}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menutheme" Tag="theme:system"
                                         IsChecked="{Binding ThemeSystem, Mode=OneWay}" Content="{local:Tr 'Follow system', '跟随系统'}"/>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menutheme" Tag="theme:light"
                                         IsChecked="{Binding ThemeLight, Mode=OneWay}" Content="{local:Tr 'Light', '浅色'}"/>
                            <RadioButton Style="{StaticResource OptionRow}" GroupName="menutheme" Tag="theme:dark"
                                         IsChecked="{Binding ThemeDark, Mode=OneWay}" Content="{local:Tr 'Dark', '深色'}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Header of the settings page: back button and title -->
            <Grid Grid.Row="0" Margin="10,14,12,12" Visibility="{Binding SettingsVisibility}">
                <Button Style="{StaticResource IconButton}" Tag="back" Content="&#xE72B;" HorizontalAlignment="Left"
                        VerticalAlignment="Center" ToolTip="{local:Tr 'Back', '返回'}"/>
                <StackPanel Margin="44,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr 'Settings', '设置'}" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SettingsSubtitle}" Foreground="{DynamicResource SubText}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Banner: not installed, not responding, update, dry run, notices -->
            <Border Grid.Row="1" Margin="12,0,12,12" CornerRadius="8" Padding="14,12" Background="{Binding BannerBg}"
                    Visibility="{Binding BannerVisibility}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding BannerGlyph}" FontFamily="{StaticResource Icons}" FontSize="16"
                               Foreground="{Binding BannerFg}" Margin="0,1,12,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BannerTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding BannerDetail}" Foreground="{DynamicResource SubText}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource AccentButton}" Tag="banner" Margin="12,0,0,0"
                            VerticalAlignment="Center" Content="{Binding BannerAction}"
                            Visibility="{Binding BannerActionVisibility}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <!-- ======================== Main page ======================== -->
                <ScrollViewer x:Name="MainPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Visibility="{Binding MainVisibility}">
                    <ScrollViewer.RenderTransform>
                        <TranslateTransform/>
                    </ScrollViewer.RenderTransform>
                    <StackPanel Margin="12,0,12,4">

                        <Grid Height="22" Margin="8,0,4,6">
                            <TextBlock Text="{local:Tr 'Lines', '线路'}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding LinesHint}" Foreground="{DynamicResource SubText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="64" Background="Transparent" ToolTip="{Binding ChartTip}">
                                            <Border Height="1" VerticalAlignment="Top" Margin="62,0,14,0"
                                                    Background="{DynamicResource Divider}" Visibility="{Binding DividerVisibility}"/>
                                            <Grid Margin="14,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="18" Background="{Binding IconBg}">
                                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16"
                                                               Foreground="{Binding IconFg}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontSize="14"/><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource SubText}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding RoleText}" Foreground="{Binding RoleBrush}" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <local:Sparkline Grid.Column="2" Width="72" Height="28" Margin="0,0,14,0"
                                                                 Values="{Binding History}" LineBrush="{Binding RoleBrush}"
                                                                 FailBrush="{DynamicResource Bad}" GridBrush="{DynamicResource Divider}"/>
                                                <CheckBox Grid.Column="3" Style="{StaticResource Toggle}" Tag="line"
                                                          IsChecked="{Binding Enabled, Mode=OneWay}" Opacity="{Binding ToggleOpacity}"
                                                          ToolTip="{local:Tr 'Allow this line to be used', '允许使用这条线路'}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Grid Height="22" Margin="8,16,0,6">
                            <TextBlock Text="{local:Tr 'Recent events', '最近事件'}" Style="{StaticResource SectionTitle}"/>
                            <Button Style="{StaticResource LinkButton}" Tag="log" Content="{local:Tr 'Open log', '打开日志'}"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Style="{StaticResource Card}" Padding="0,6">
                            <Grid>
                                <TextBlock Text="{local:Tr 'No events yet', '暂无事件'}" Foreground="{DynamicResource SubText}"
                                           Margin="16,8" Visibility="{Binding EventsEmpty}"/>
                                <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="30" Margin="16,0,14,0" ToolTip="{Binding Full}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="6" Height="6" Fill="{Binding Dot}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" Foreground="{DynamicResource SubText}"
                                                           Margin="10,0,10,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================== Settings page ======================== -->
                <!-- Tabs keep every group short: General | Probing | Wi-Fi | More -->
                <Grid x:Name="SettingsPage" Visibility="{Binding SettingsVisibility}">
                    <Grid.RenderTransform>
                        <TranslateTransform/>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="12,0,12,12" Padding="2" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Stroke}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="0.75*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0" Padding="4,4" Style="{StaticResource Segment}" GroupName="tabs" Tag="tab:general"
                                         IsChecked="{Binding TabGeneral, Mode=OneWay}" Content="{local:Tr 'General', '常规'}"/>
                            <RadioButton Grid.Column="1" Padding="4,4" Style="{StaticResource Segment}" GroupName="tabs" Tag="tab:probe"
                                         IsChecked="{Binding TabProbe, Mode=OneWay}" Content="{local:Tr 'Probing', '探测'}"/>
                            <RadioButton Grid.Column="2" Padding="4,4" Style="{StaticResource Segment}" GroupName="tabs" Tag="tab:wifi"
                                         IsChecked="{Binding TabWifi, Mode=OneWay}" Content="Wi-Fi"/>
                            <RadioButton Grid.Column="3" Padding="4,4" Style="{StaticResource Segment}" GroupName="tabs" Tag="tab:repair"
                                         IsChecked="{Binding TabRepair, Mode=OneWay}" Content="{local:Tr 'Repair', '修复'}"/>
                            <RadioButton Grid.Column="4" Padding="4,4" Style="{StaticResource Segment}" GroupName="tabs" Tag="tab:ai"
                                         IsChecked="{Binding TabAi, Mode=OneWay}" Content="AI"/>
                            <RadioButton Grid.Column="5" Padding="4,4" Style="{StaticResource Segment}" GroupName="tabs" Tag="tab:more"
                                         IsChecked="{Binding TabMore, Mode=OneWay}" Content="{local:Tr 'More', '更多'}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid Margin="12,0,12,4">
                            <StackPanel Visibility="{Binding TabGeneralVisibility}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Automatic switching', '自动切换'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'Switch on outage, back on recovery', '断网时换到可用线路，恢复后切回'}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" Tag="pause"
                                          IsChecked="{Binding AutoSwitch, Mode=OneWay}" Opacity="{Binding AutoSwitchOpacity}"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Start at sign-in', '登录时启动'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'Show the status icon in the tray', '在通知区域显示网络状态图标'}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" Tag="autostart"
                                          IsChecked="{Binding AutoStart, Mode=OneWay}"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Check for updates automatically', '自动检查更新'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'Look for a new release on GitHub once a day', '每天检查一次 GitHub 上的新版本'}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" Tag="autoupdate"
                                          IsChecked="{Binding AutoUpdate, Mode=OneWay}"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{Binding VersionText}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{Binding UpdateStatusText}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Tag="checkupdate" MinWidth="0"
                                        Content="{local:Tr 'Check now', '检查更新'}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                            </StackPanel>
                            <StackPanel Visibility="{Binding TabProbeVisibility}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Margin="14,12,14,4">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Probe targets', '探测目标'}"/>
                                <TextBlock Style="{StaticResource RowDetail}"
                                           Text="{local:Tr 'IP addresses, host names or http(s):// URLs, up to 10. A URL only counts as reachable when it answers with 2xx.', 'IP 地址、域名或 http(s):// 网址，最多 10 个。网址只有返回 2xx 才算可达。'}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Targets}" Focusable="False" Margin="14,0,8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="12"
                                                       Foreground="{DynamicResource SubText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="removetarget" Width="30" Height="30"
                                                    Content="&#xE711;" ToolTip="{local:Tr 'Remove', '删除'}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="14,6,14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="NewTargetBox" Style="{StaticResource InputBox}"
                                         Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="{local:Tr 'e.g. 1.1.1.1 or https://example.com', '例如 1.1.1.1 或 https://example.com'}"/>
                                <Button Grid.Column="1" Style="{StaticResource ActionButton}" Tag="addtarget" MinWidth="0" Margin="8,0,0,0"
                                        Content="{local:Tr 'Add', '添加'}"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>

                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Failed targets for an outage', '几个目标失效算断网'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{Binding FailTargetsHint}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StepButton}" Tag="dec:failTargets" Content="&#xE949;"/>
                                    <TextBlock Text="{Binding FailTargetsText}" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource StepButton}" Tag="inc:failTargets" Content="&#xE948;"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Timeout', '超时'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'How long one probe waits for an answer', '单次探测等待回复的时间'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StepButton}" Tag="dec:pingTimeoutMs" Content="&#xE949;"/>
                                    <TextBlock Text="{Binding TimeoutText}" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource StepButton}" Tag="inc:pingTimeoutMs" Content="&#xE948;"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Check interval', '检测间隔'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'Pause between two rounds of probes', '两轮探测之间的间隔'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StepButton}" Tag="dec:intervalSeconds" Content="&#xE949;"/>
                                    <TextBlock Text="{Binding IntervalText}" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource StepButton}" Tag="inc:intervalSeconds" Content="&#xE948;"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Rounds before switching', '判定断网'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'Failed rounds in a row before a line counts as down', '连续失败几轮才判定线路断网'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StepButton}" Tag="dec:failThreshold" Content="&#xE949;"/>
                                    <TextBlock Text="{Binding FailThresholdText}" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource StepButton}" Tag="inc:failThreshold" Content="&#xE948;"/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Rounds before switching back', '判定恢复'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'Successful rounds in a row before the primary line is used again', '主线路连续成功几轮才切回'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StepButton}" Tag="dec:recoverThreshold" Content="&#xE949;"/>
                                    <TextBlock Text="{Binding RecoverText}" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource StepButton}" Tag="inc:recoverThreshold" Content="&#xE948;"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                            </StackPanel>
                            <StackPanel Visibility="{Binding TabWifiVisibility}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Try saved Wi-Fi networks', '断网时逐个尝试 Wi-Fi'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'Connect to saved networks, strongest first, until one has internet', '按信号从强到弱连接保存过的网络，直到能上网'}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" Tag="wifihunt"
                                          IsChecked="{Binding WifiHunt, Mode=OneWay}"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="14,12">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{local:Tr 'Retry a failed network after', '失败网络重试间隔'}"/>
                                    <TextBlock Style="{StaticResource RowDetail}" Text="{local:Tr 'A network without internet is skipped for this long', '不能上网的网络在这段时间内不再尝试'}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StepButton}" Tag="dec:wifiRetryMinutes" Content="&#xE949;"/>
                                    <TextBlock Text="{Binding WifiRetryText}" Width="58" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource StepButton}" Tag="inc:wifiRetryMinutes" Content="&#xE948;"/>
                                </StackPanel>
