<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:NetWatchdogUI"
        Title="{Binding Title}" Width="600" Height="660"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <TextBlock Text="{Binding Title}" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Tag="minimize" Content="&#xE921;"/>
                    <Button Style="{StaticResource CloseButton}" Tag="close" Content="&#xE8BB;" IsEnabled="{Binding CanClose}"/>
                </StackPanel>
            </Grid>

            <!-- App name and version -->
            <Grid Grid.Row="1" Margin="32,8,32,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIcon" Width="56" Height="56"/>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"/>
                    <TextBlock Text="{Binding Subheading}" Foreground="{DynamicResource SubText}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Page 1: install or uninstall options -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Visibility="{Binding WelcomeVisibility}">
                <StackPanel Margin="24,0,24,16">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="20" Margin="8,0,8,16"
                               Foreground="{DynamicResource SubText}"/>

                    <!-- Install: detected lines -->
                    <StackPanel Visibility="{Binding InstallVisibility}">
                        <Grid Height="22" Margin="8,0,4,6">
                            <TextBlock Text="{local:Tr 'Lines', '线路'}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{Binding LinesHint}" Foreground="{DynamicResource SubText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <TextBlock Text="{Binding LinesNote}" Foreground="{DynamicResource SubText}" Margin="16,14"
                                           TextWrapping="Wrap" Visibility="{Binding LinesNoteVisibility}"/>
                                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="56">
                                                <Border Height="1" VerticalAlignment="Top" Margin="62,0,14,0"
                                                        Background="{DynamicResource Divider}" Visibility="{Binding DividerVisibility}"/>
                                                <Grid Margin="14,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="16"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubText}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <!-- Install: options -->
                        <Grid Height="22" Margin="8,16,4,6">
                            <TextBlock Text="{local:Tr 'Options', '选项'}" Style="{StaticResource SectionTitle}"/>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Height="62" Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                                        <TextBlock Text="&#xE701;" FontFamily="{StaticResource Icons}" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{local:Tr 'Wi-Fi standby (recommended)', 'Wi-Fi 热备（推荐）'}" FontSize="14"/>
                                        <TextBlock Text="{local:Tr 'Keep Wi-Fi connected while wired is up for instant switching; applies after restart', '有线接通时保持 Wi-Fi 连接，切换无需等待，重启后生效'}" Foreground="{DynamicResource SubText}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding OptStandby}"/>
                                </Grid>
                                <Border Height="1" Margin="62,0,14,0" Background="{DynamicResource Divider}"/>
                                <Grid Height="62" Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{local:Tr 'Start the tray panel at sign-in', '登录时启动托盘面板'}" FontSize="14"/>
                                        <TextBlock Text="{local:Tr 'Show the status icon in the tray', '在通知区域显示网络状态图标'}" Foreground="{DynamicResource SubText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding OptAutostart}"/>
                                </Grid>
                                <Border Height="1" Margin="62,0,14,0" Background="{DynamicResource Divider}"/>
                                <Grid Height="62" Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                                        <TextBlock Text="&#xE8FC;" FontFamily="{StaticResource Icons}" FontSize="16"
                                                   Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{local:Tr 'Start menu shortcut', '开始菜单快捷方式'}" FontSize="14"/>
                                        <TextBlock Text="{local:Tr 'Add NetWatchdog to the Start menu', '在开始菜单里添加“网络看门狗”'}" Foreground="{DynamicResource SubText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding OptShortcut}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Install: location -->
                        <Grid Height="22" Margin="8,16,4,6">
                            <TextBlock Text="{local:Tr 'Install location', '安装位置'}" Style="{StaticResource SectionTitle}"/>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <Grid Height="56" Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="16"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InstallDir}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding InstallDir}"/>
                                    <TextBlock Text="{Binding InstallDirNote}" Foreground="{DynamicResource SubText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource LinkButton}" Tag="browse" Content="{local:Tr 'Change…', '更改…'}"
                                        VerticalAlignment="Center" Visibility="{Binding BrowseVisibility}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Uninstall: options -->
                    <StackPanel Visibility="{Binding UninstallVisibility}">
                        <Grid Height="22" Margin="8,0,4,6">
                            <TextBlock Text="{local:Tr 'Options', '选项'}" Style="{StaticResource SectionTitle}"/>
                        </Grid>
                        <Border Style="{StaticResource Card}">
                            <Grid Height="62" Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource BadSoft}">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="16"
                                               Foreground="{DynamicResource Bad}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{local:Tr 'Delete settings and log', '删除设置和日志'}" FontSize="14"/>
                                    <TextBlock Text="{local:Tr 'If kept, a later install reuses the current config and disabled lines', '保留时，重新安装会沿用现在的配置和停用的线路'}" Foreground="{DynamicResource SubText}"
                                               Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding OptRemoveData}"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding UninstallNote}" Foreground="{DynamicResource SubText}" TextWrapping="Wrap"
                                   LineHeight="20" Margin="8,14,8,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Page 2: progress -->
            <StackPanel Grid.Row="2" Margin="32,8,32,16" Visibility="{Binding ProgressVisibility}">
                <TextBlock Text="{Binding StepText}" FontSize="14"/>
                <ProgressBar Style="{StaticResource Progress}" Value="{Binding Progress}" Margin="0,14,0,20"/>
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="12"
                                           Foreground="{Binding Brush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{Binding TextBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Page 3: finished or failed -->
            <StackPanel Grid.Row="2" Margin="32,24,32,16" Visibility="{Binding DoneVisibility}">
                <Border Width="64" Height="64" CornerRadius="32" Background="{Binding DoneSoft}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DoneGlyph}" FontFamily="{StaticResource Icons}" FontSize="28"
                               Foreground="{Binding DoneBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding DoneTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <TextBlock Text="{Binding DoneDetail}" Foreground="{DynamicResource SubText}" TextWrapping="Wrap"
                           LineHeight="20" Margin="0,8,0,0"/>
                <Border Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="{Binding LaunchVisibility}">
                    <Grid Height="56" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{local:Tr 'Open the tray panel when done', '完成后打开托盘面板'}" FontSize="14" VerticalAlignment="Center"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding OptLaunch}"/>
                    </Grid>
                </Border>
                <Button Style="{StaticResource LinkButton}" Tag="openlog" Content="{local:Tr 'View setup log', '查看安装日志'}" HorizontalAlignment="Left"
                        Margin="-6,12,0,0" Visibility="{Binding LogLinkVisibility}"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="3" Background="{DynamicResource Footer}" Height="64">
                <Grid Margin="32,0,24,0">
                    <TextBlock Text="{Binding FooterNote}" Foreground="{DynamicResource SubText}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,220,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ActionButton}" Tag="secondary" Content="{Binding SecondaryText}"
                                Visibility="{Binding SecondaryVisibility}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Tag="primary" Content="{Binding PrimaryText}"
                                Height="32" MinWidth="96" IsEnabled="{Binding PrimaryEnabled}"
                                Visibility="{Binding PrimaryVisibility}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
